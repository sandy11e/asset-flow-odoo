generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditStatus {
  OPEN
  CLOSED
}
enum UserRole {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum AllocationStatus {
  ACTIVE
  RETURNED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)

  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[] @relation("DepartmentHierarchy")

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetCategory {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("asset_categories")
}

model User {
  id String @id @default(uuid())

  name     String
  email    String @unique
  password String

  phone String?

  role   UserRole   @default(EMPLOYEE)
  status UserStatus @default(ACTIVE)

  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  allocations         AssetAllocation[]
  bookings            ResourceBooking[]
  maintenanceRequests MaintenanceRequest[]
  notifications Notification[]
  allocatedAssets AssetAllocation[] @relation("AllocatedBy")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([departmentId])
  @@map("users")
}

model Asset {
  id String @id @default(uuid())

  assetTag String @unique
  name     String

  serialNumber String? @unique

  categoryId String
  category   AssetCategory @relation(fields: [categoryId], references: [id])

  acquisitionDate DateTime?

  acquisitionCost Decimal? @db.Decimal(10, 2)

  condition AssetCondition @default(GOOD)

  status AssetStatus @default(AVAILABLE)

  location String

  isBookable Boolean @default(false)

  qrCode String?

  imageUrl String?

  allocations         AssetAllocation[]
  bookings            ResourceBooking[]
  maintenanceRequests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetTag])
  @@index([serialNumber])
  @@index([status])
  @@index([categoryId])
  @@map("assets")
}

model AssetAllocation {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  allocatedById String
  allocatedBy   User   @relation("AllocatedBy", fields: [allocatedById], references: [id])

  allocatedAt DateTime @default(now())

  expectedReturnDate DateTime?

  returnedAt DateTime?

  status AllocationStatus @default(ACTIVE)

  remarks String?

  @@index([assetId])
  @@index([userId])
  @@map("asset_allocations")
}

model ResourceBooking {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title String

  startTime DateTime
  endTime   DateTime

  status BookingStatus @default(UPCOMING)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([userId])
  @@map("resource_bookings")
}

model MaintenanceRequest {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  reportedById String
  reportedBy   User   @relation(fields: [reportedById], references: [id])

  issue    String
  priority String

  status MaintenanceStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_requests")
}
model Notification {
  id        String   @id @default(uuid())

  title     String
  message   String

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}
model ActivityLog {
  id        String   @id @default(uuid())

  userName  String

  action    String

  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model AuditCycle {
  id           String        @id @default(uuid())

  title        String
  department   String

  startDate    DateTime
  endDate      DateTime

  status       AuditStatus   @default(OPEN)

  createdAt    DateTime      @default(now())

  @@map("audit_cycles")
}